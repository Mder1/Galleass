			x="0.0"
			y="-24.25"
			z="-1.4" />
		<deployment_area
			width="12.10"
			length="59.93" />
		<!-- sail i = prefab rig tagged sail_center_i: 0 main (large lateen), 1 fore (medium), 2 mizzen (small), 3 spritsail
		     (vanilla small square rig scaled 0.58 under the bowsprit, user 2026-10-19).
		     NO comments inside <sails>: MissionShipObject reads every child node as a sail - a comment there made the
		     whole ship invalid ('Null object reference found with ID: ship_galleass', campaign map crash 2026-10-19).
		     Mizzen left limit 150 (not 170): pointing aft its lower yard end ran through the stern lantern (user 2026-10-13) -->
		<!-- handling (user 2026-11-08, after the historical galleasses: heavy and cumbersome, weak under oars, but good
		     sailers): mass 240 t, oarsmen force 10 / tip speed 5.0 (was 16 / 6.2), rudder 420k / rate 3, sails 11/8/5/3
		     (was 7/5/3/2); max_linear_* / max_angular_* only feed the AI's path planning -->
		<sails>
			<sail
				type="lateen"
				force_multiplier="11"
				left_rotation_limit="170"
				right_rotation_limit="5"
				rotation_rate="10" />
			<sail
				type="lateen"
				force_multiplier="8"
				left_rotation_limit="170"
				right_rotation_limit="5"
				rotation_rate="12" />
			<sail
				type="lateen"
				force_multiplier="5"
				left_rotation_limit="150"
				right_rotation_limit="5"
				rotation_rate="16" />
			<sail
				type="square"
				force_multiplier="3"
				left_rotation_limit="50"
				right_rotation_limit="50"
				rotation_rate="18" />
		</sails>
		<linear_friction_multiplier
			side="1.0"
			forward="1.0"
			backward="1.0"
			up="1.0"
			down="1.0" />
		<angular_friction_multiplier
			pitch="1.0"
			roll="1.0"
			yaw="0.3" />
		<moment_of_inertia_multiplier
			x="1.0"
			y="1.0"
			z="0.9" />
	</MissionShip>
</MissionShips>
